def COLOR_MAP = [                                      // Color mapping for Slack notifications based on build result
    'SUCCESS': 'good',                                 // Green color for successful builds
    'FAILURE': 'danger',                               // Red color for failed builds
]
pipeline {
    agent any                                          // Run on any available Jenkins agent
    tools {
        maven "MAVEN3.9"                               // Use Maven 3.9 tool configuration
        jdk "JDK17"                                    // Use JDK 17 for compilation
    }
    stages {
        stage('test slack'){                           // Test stage to verify Slack integration
            steps{
                sh 'NotARealCommand'                   // Intentional failure to test notifications
            }
        }
        stage('Fetch code') {                          // Clone source code from repository
            steps {
               git branch: 'atom', url: 'https://github.com/hkhcoder/vprofile-project.git'  // Git checkout from atom branch
            }
        }
        stage('Build'){                                // Compile and package the application
            steps{
               sh 'mvn install -DskipTests'            // Maven build without running tests
            }
            post {                                     // Post-build actions
               success {
                  echo 'Now Archiving it...'           // Log message for successful build
                  archiveArtifacts artifacts: '**/target/*.war'  // Archive WAR files as build artifacts
               }
            }
        }
        stage('UNIT TEST') {                           // Execute unit tests
            steps{
                sh 'mvn test'                          // Run Maven test phase
            }
        }
        stage('Checkstyle Analysis') {                 // Code quality analysis with Checkstyle
            steps{
                sh 'mvn checkstyle:checkstyle'         // Generate Checkstyle reports
            }
        }
        stage("Sonar Code Analysis") {                 // SonarQube static code analysis
            environment {
                scannerHome = tool 'sonar6.2'          // Set SonarQube scanner tool path
            }
            steps {
              withSonarQubeEnv('sonarserver') {        // Use configured SonarQube server
                sh '''${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=vprofile \
                   -Dsonar.projectName=vprofile \       // Project identification in SonarQube
                   -Dsonar.projectVersion=1.0 \         // Project version
                   -Dsonar.sources=src/ \               // Source code directory
                   -Dsonar.java.binaries=target/test-classes/com/visualpathit/account/controllerTest/ \  // Compiled test classes
                   -Dsonar.junit.reportsPath=target/surefire-reports/ \     // JUnit test reports location
                   -Dsonar.jacoco.reportsPath=target/jacoco.exec \          // Code coverage reports
                   -Dsonar.java.checkstyle.reportPaths=target/checkstyle-result.xml'''  // Checkstyle report path
              }
            }
        }
        stage("Quality Gate") {                        // Wait for SonarQube quality gate result
            steps {
              timeout(time: 1, unit: 'HOURS') {        // Set 1-hour timeout for quality gate
                waitForQualityGate abortPipeline: true  // Fail pipeline if quality gate fails
              }
            }
          }
         stage("UploadArtifact"){                      // Upload build artifacts to Nexus repository
            steps{
                nexusArtifactUploader(
                  nexusVersion: 'nexus3',               // Nexus repository version
                  protocol: 'http',                     // Connection protocol
                  nexusUrl: '172.31.25.14:8081',       // Nexus server URL and port
                  groupId: 'QA',                        // Maven group ID
                  version: "${env.BUILD_ID}-${env.BUILD_TIMESTAMP}",  // Dynamic version using build info
                  repository: 'vprofile-repo',          // Target repository name
                  credentialsId: 'nexuslogin',          // Jenkins credentials for Nexus authentication
                  artifacts: [                          // List of artifacts to upload
                    [artifactId: 'vproapp',             // Artifact identifier
                     classifier: '',                    // Optional classifier (empty)
                     file: 'target/vprofile-v2.war',   // Path to WAR file
                     type: 'war']                       // Artifact type
                  ]
                )
            }
        }
    }
  post {                                               // Post-pipeline actions (always executed)
        always {
            echo 'Slack Notifications.'                // Log message before sending notification
            slackSend channel: '#devopscicd',          // Target Slack channel
                color: COLOR_MAP[currentBuild.currentResult],  // Color based on build result
                message: "*${currentBuild.currentResult}:* Job ${env.JOB_NAME} build ${env.BUILD_NUMBER} \n More info at: ${env.BUILD_URL}"  // Notification message with build details
        }
    }
}